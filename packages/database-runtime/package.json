{
  "name": "@chat/database-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./src/runner.ts",
      "default": "./dist/runner.js"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./dist/catalog.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@chat/contracts": "workspace:*",
    "@chat/credential-seal": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@sezzlee/db-core": "workspace:*",
    "@sezzlee/mssql-mcp": "workspace:*",
    "@sezzlee/postgres-mcp": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@chat/oxlint-config": "workspace:*",
    "@sezzlee/oxlint-config": "workspace:*",
    "@sezzlee/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
